+// review5: ADAPTIVE hold. v3 held B(n) for a fixed 20 ms. On weak hardware the render thread's frame-start time read can
+// come later than 20 ms after Present returns (slow CPU, heavy input/event processing, page faults), so it saw a crept
+// value: per-frame dt jittered between 0 and 2/FPS (visible stutter / near-duplicate frames) even though the total stayed
+// exact. Now the render thread's first clock read of every step is timed, and the hold is 4x a decaying maximum of that
+// latency (clamped to 20 ms .. 1 s). The first read therefore lands in the hold window and gets exactly B(n) -> dt is
+// exactly 1/FPS. Frame limiters still finish (the creep after the hold is unchanged); they only wait a bit longer.
+// The first steps of a take use a conservative 200 ms hold (initial latency estimate 50 ms) that decays to the measured value.
+static std::atomic<DWORD>   g_renderTid{ 0 };          // thread that presents the recorded target
+static std::atomic<bool>    g_firstReadPending{ false };
+static std::atomic<int64_t> g_firstReadLat{ 0 };      // decaying max of (render-thread first read - step anchor), ticks
+static std::atomic<int64_t> g_anchorReal{ 0 };
+static int64_t HoldTicks() {
+    const int64_t minH = g_freq / 50, maxH = g_freq;   // 20 ms .. 1 s
+    int64_t h = g_firstReadLat.load(std::memory_order_relaxed) * 4;
+    return h < minH ? minH : (h > maxH ? maxH : h);
+}
+static void NoteRenderRead(int64_t real) {
+    if (!g_firstReadPending.load(std::memory_order_relaxed)) return;
+    if (GetCurrentThreadId() != g_renderTid.load(std::memory_order_relaxed)) return;
